# ══════════════════════════════════════════════════════════════════════════════
# LinkedIn Job Finder — Environment Configuration
# Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════


# ── LinkedIn ───────────────────────────────────────────────────────────────────
# No credentials needed. The scraper opens a browser window and waits for you
# to log in manually. Your session is saved to CHROME_PROFILE_DIR so subsequent
# runs stay logged in automatically.


# ══════════════════════════════════════════════════════════════════════════════
# AI PROVIDER
# Controls which AI backend is used for triage and job enrichment.
#
#   "openai"  (default) — OpenAI-compatible APIs: Groq, Ollama, or any
#                         OpenAI-spec endpoint. Configure the OPENAI section below.
#   "claude"            — Anthropic Claude. Two auth modes (see CLAUDE section):
#                           • ANTHROPIC_API_KEY set  → direct API, prompt caching
#                           • ANTHROPIC_API_KEY empty → Claude Code subscription
# ══════════════════════════════════════════════════════════════════════════════

AI_PROVIDER=openai


# ── Claude provider ────────────────────────────────────────────────────────────
# Only used when AI_PROVIDER=claude.
#
# ANTHROPIC_API_KEY
#   Option A — leave empty: reuses your Claude Code CLI login (~/.claude/).
#              Works with Claude Pro/Max subscription. No per-token billing.
#   Option B — set to sk-ant-...: calls Anthropic API directly.
#              Enables server-side prompt caching (~90% token savings on batches).
#              Get a key at: https://console.anthropic.com/keys
#
# CLAUDE_MODEL
#   Any model available on your plan, e.g. claude-sonnet-4-6, claude-opus-4-8.
#   Leave blank to use the Claude Code default when running without an API key.
# ──────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6


# ── OpenAI-compatible provider ────────────────────────────────────────────────
# Only used when AI_PROVIDER=openai.
#
# PLATFORM
#   Shortcut that sets base URL, model list, delay, and timeout automatically.
#   Override any individual value below to customise.
#
#   "ollama" → http://localhost:11434/v1       | model: llama3      | timeout: 300s | delay: 2s
#   "groq"   → https://api.groq.com/openai/v1 | model rotation     | timeout: 60s  | delay: 5s
# ──────────────────────────────────────────────────────────────────────────────
PLATFORM=groq

# API key for the selected platform.
#   Groq:   get from https://console.groq.com/keys
#   Ollama: any non-empty string works (e.g. "ollama")
OPENAI_API_KEY=your_groq_api_key_here

# ── OpenAI overrides (optional) ───────────────────────────────────────────────
# Remove or comment out to use PLATFORM defaults.
#
# OPENAI_BASE_URL — API endpoint (default set by PLATFORM)
# OPENAI_MODELS   — comma-separated list; analyzer rotates through them on
#                   rate-limit or payload-too-large errors
# ──────────────────────────────────────────────────────────────────────────────
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODELS=llama3-70b-8192,mixtral-8x7b-32768,gemma2-9b-it


# ── AI behaviour (shared across all providers) ────────────────────────────────
# AI_ANALYSIS_DELAY      — seconds to sleep between each post analysis (float ok)
# AI_REQUEST_TIMEOUT     — per-request HTTP timeout in seconds
# AI_MAX_TOKENS_ENRICH   — max tokens for full job enrichment response
# AI_MAX_TOKENS_TRIAGE   — max tokens for triage decision response
# AI_TRIAGE_FIRST        — true: run a cheap triage call before full enrichment;
#                          skips obviously irrelevant posts and saves API quota
# AI_CONCURRENT_ANALYSES — parallel analyses in worker mode (not used in main.py)
# QUEUE_CLAIM_BATCH_SIZE — how many queue items the worker claims per batch
# ──────────────────────────────────────────────────────────────────────────────
AI_ANALYSIS_DELAY=15
# AI_REQUEST_TIMEOUT=120
# AI_MAX_TOKENS_ENRICH=1600
# AI_MAX_TOKENS_TRIAGE=180
# AI_TRIAGE_FIRST=false
# AI_CONCURRENT_ANALYSES=3
# QUEUE_CLAIM_BATCH_SIZE=6


# ── Scraper behaviour ─────────────────────────────────────────────────────────
# FEED_SCROLL_COUNT    — number of scroll passes on the LinkedIn home feed
# FEED_SCROLL_DELAY    — seconds to wait between each feed scroll (float ok)
# HASHTAG_SCROLL_COUNT — scroll passes per keyword/hashtag search page
# POSTS_PER_HASHTAG    — max posts collected per keyword or hashtag query
# ACTION_DELAY_MIN     — minimum random pause between browser actions (seconds)
# ACTION_DELAY_MAX     — maximum random pause between browser actions (seconds)
# FEED_AI_TRIAGE_RAW   — true (default): collect all feed posts without a
#                        keyword gate; AI triage filters them downstream.
#                        false: only collect posts containing hiring keywords.
# ──────────────────────────────────────────────────────────────────────────────
# FEED_SCROLL_COUNT=8
# FEED_SCROLL_DELAY=2
# HASHTAG_SCROLL_COUNT=3
# POSTS_PER_HASHTAG=25
# ACTION_DELAY_MIN=2
# ACTION_DELAY_MAX=3
# FEED_AI_TRIAGE_RAW=true


# ── Search filters ────────────────────────────────────────────────────────────
# Applied to every LinkedIn content search (keywords and hashtags).
#
# SEARCH_FILTER_DATE_POSTED — LinkedIn datePosted facet value.
#   '["past-24h"]'  — last 24 hours (default; keeps results fresh)
#   '["past-week"]' — last 7 days (more results, older posts)
#   ''              — no date filter
#
# SEARCH_FILTER_CONTENT_TYPE — LinkedIn contentType facet value.
#   "jobs"          — job-related posts (default)
#   ''              — no content-type filter (broader results)
#   Note: contentType=["jobs"] is a post filter, NOT the LinkedIn Jobs tab.
# ──────────────────────────────────────────────────────────────────────────────
# SEARCH_FILTER_DATE_POSTED=["past-24h"]
# SEARCH_FILTER_CONTENT_TYPE=jobs


# ── App ───────────────────────────────────────────────────────────────────────
# CHROME_PROFILE_DIR — path to persistent Chrome profile (keeps LinkedIn login)
# NEXTJS_API_URL     — base URL of the Next.js dashboard API; leave blank to
#                      disable saving results to the dashboard
# ──────────────────────────────────────────────────────────────────────────────
CHROME_PROFILE_DIR=./browser_profile
NEXTJS_API_URL=http://localhost:3000
