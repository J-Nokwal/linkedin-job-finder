LINKEDIN_EMAIL=abcd@gmail.com
LINKEDIN_PASSWORD=xyz

# ── AI Platform ────────────────────────────────────────────────
# Set PLATFORM to switch between local Ollama and Groq cloud.
# All AI defaults (base_url, models, timeout, delay) are set automatically.
#
#   PLATFORM=ollama  →  http://localhost:11434/v1  |  model: llama3  |  timeout: 300s
#   PLATFORM=groq    →  https://api.groq.com/openai/v1  |  model rotation  |  timeout: 60s
#
PLATFORM=groq

# ── API key ────────────────────────────────────────────────────
# Ollama: leave as "ollama" (or any non-empty string)
# Groq:   paste your key from https://console.groq.com/keys
OPENAI_API_KEY=your_groq_api_key_here

# ── Overrides (optional — remove to use platform defaults) ─────
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODELS=llama3-70b-8192,mixtral-8x7b-32768,gemma2-9b-it
# AI_ANALYSIS_DELAY=5
# AI_REQUEST_TIMEOUT=60

# ── App ────────────────────────────────────────────────────────
CHROME_PROFILE_DIR=./browser_profile
NEXTJS_API_URL=http://localhost:3000
